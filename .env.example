# HOA Chatbot environment template.
# Copy to .env for local development; set on Railway via the dashboard for prod.
# Real values are NEVER committed; .env is gitignored.

# === Flask ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=
FLASK_ENV=production

# === SQLite ===
# Local default: ./hoa_bot.db. On Railway: /data/hoa_bot.db (volume mount).
DATABASE_PATH=./hoa_bot.db

# === Data directory (whitelisted senders, document files) ===
# Local default: ./data. On Railway: /data.
DATA_DIR=./data

# === Encryption (Fernet, 32-byte url-safe base64) ===
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: rotating this key invalidates every encrypted row in `config`.
# Document a key-rotation procedure before changing in production.
ENCRYPTION_KEY=

# === Anthropic ===
# COST FLAG: Anthropic Haiku, ~$0.001 per chat.
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER
ANTHROPIC_MODEL=claude-haiku-4-5

# === Voyage ===
# COST FLAG: Voyage embeddings, free tier covers v1.
VOYAGE_API_KEY=pa-PLACEHOLDER
VOYAGE_MODEL=voyage-3-lite

# === Gmail OAuth ===
# Refresh token is NOT stored here; written encrypted to config table by
# scripts/gmail_oauth_setup.py. Client id and secret stay in env for bootstrap.
GMAIL_CLIENT_ID=PLACEHOLDER.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=PLACEHOLDER
GMAIL_BOT_ADDRESS=hoabot@example.com

# === HOA-specific (mutable via /admin/config; these are first-deploy seeds) ===
HOA_CONTACT_EMAIL=board@example.com
COMMUNITY_NAME=Example HOA

# === Admin password (set via scripts/set_admin_password.py; not via env) ===
# ADMIN_PASSWORD_HASH is written to the config table directly. Leave blank here.

# === Operational ===
LOG_LEVEL=INFO

# === Scheduler skip flag (used by scripts that should not start APScheduler) ===
# Leave unset in normal operation. Scripts set this to 1 when they import the app factory.
# FLASK_SKIP_SCHEDULER=
